# LANDGUARD-X Environment Configuration
# The application runs fully offline with local demo data if these are left blank.

# Optional: real weather API key (e.g. OpenWeatherMap). If blank, the backend
# serves clearly-labelled "Prototype Demonstration Data" instead.
WEATHER_API_KEY=

# Optional: geocoding/map API key for arbitrary location search beyond the
# built-in demo locations (e.g. Mapbox/Google Maps). Leaflet + OpenStreetMap
# tiles are used by default and need no key.
MAP_API_KEY=

# Backend host/port (defaults shown)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
